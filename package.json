{
  "name": "flacso-meet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:rename-asistencia-tecnica": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/rename-asistencia-tecnica.sql",
    "db:studio": "prisma studio",
    "migrate:users:dry": "tsx scripts/migrate-legacy-users.ts",
    "migrate:users": "tsx scripts/migrate-legacy-users.ts --apply",
    "restore:legacy-passwords:dry": "tsx scripts/restore-legacy-passwords.ts",
    "restore:legacy-passwords": "tsx scripts/restore-legacy-passwords.ts --apply",
    "migrate:meetings:dry": "tsx scripts/migrate-legacy-meetings.ts",
    "migrate:meetings": "tsx scripts/migrate-legacy-meetings.ts --apply",
    "cleanup:cancelled-instances:dry": "tsx scripts/cleanup-cancelled-instances.ts",
    "cleanup:cancelled-instances": "tsx scripts/cleanup-cancelled-instances.ts --apply",
    "split:requests-by-meet-link:dry": "tsx scripts/split-requests-by-meet-link.ts",
    "split:requests-by-meet-link": "tsx scripts/split-requests-by-meet-link.ts --apply",
    "backfill:auto-cohosts:dry": "tsx scripts/backfill-auto-cohosts.ts",
    "backfill:auto-cohosts:local": "tsx scripts/backfill-auto-cohosts.ts --apply --no-sync-google",
    "backfill:auto-cohosts": "tsx scripts/backfill-auto-cohosts.ts --apply --sync-google",
    "sync:existing-cohosts": "tsx scripts/backfill-auto-cohosts.ts --apply --sync-google --sync-all-google",
    "seed:meet-hosts": "tsx scripts/seed-meet-hosts.ts",
    "assign:meet-hosts:dry": "tsx scripts/assign-future-meet-hosts.ts",
    "assign:meet-hosts": "tsx scripts/assign-future-meet-hosts.ts --apply",
    "test": "vitest run",
    "validate:schema": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer-secure": "npm:nodemailer@^9.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
