{
  "name": "salavirtual-flacso",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-with-tunnel.mjs",
    "dev:next": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:rename-asistencia-tecnica": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/rename-asistencia-tecnica.sql",
    "db:add-cese-asistente-tecnico": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/add-cese-asistente-tecnico.sql",
    "db:add-idempotencia-creacion-reunion": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/add-idempotencia-creacion-reunion.sql",
    "db:add-descripcion-instancia": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/add-descripcion-instancia.sql",
    "db:add-asistencia-hibrida-horarios": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/add-asistencia-hibrida-horarios.sql",
    "db:add-solicitudes-acceso-google": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/add-solicitudes-acceso-google.sql",
    "db:studio": "prisma studio",
    "zoom:archivos:worker": "tsx scripts/zoom-archivos-worker.ts",
    "zoom:archivos:historico:dry": "tsx scripts/recuperar-archivos-zoom.ts",
    "zoom:archivos:historico": "tsx scripts/recuperar-archivos-zoom.ts --apply",
    "build:zoom-worker": "esbuild scripts/zoom-archivos-worker.ts --bundle --platform=node --format=cjs --target=node24 --external:@prisma/client --external:.prisma/client --outfile=.zoom-worker/zoom-archivos-worker.cjs --log-level=warning",
    "migrate:users:dry": "tsx scripts/migrate-legacy-users.ts",
    "migrate:users": "tsx scripts/migrate-legacy-users.ts --apply",
    "restore:legacy-passwords:dry": "tsx scripts/restore-legacy-passwords.ts",
    "restore:legacy-passwords": "tsx scripts/restore-legacy-passwords.ts --apply",
    "migrate:meetings:dry": "tsx scripts/migrate-legacy-meetings.ts",
    "migrate:meetings": "tsx scripts/migrate-legacy-meetings.ts --apply",
    "cleanup:cancelled-instances:dry": "tsx scripts/cleanup-cancelled-instances.ts",
    "cleanup:cancelled-instances": "tsx scripts/cleanup-cancelled-instances.ts --apply",
    "unificar:links-series:dry": "tsx scripts/unificar-links-series-futuras.ts",
    "unificar:links-series": "tsx scripts/unificar-links-series-futuras.ts --apply",
    "asignar:link-serie": "tsx scripts/asignar-link-meet-serie.ts",
    "actualizar:cohosts-serie": "tsx scripts/actualizar-cohosts-serie.ts",
    "resync:cohosts": "tsx scripts/resincronizar-cohosts-existentes.ts",
    "backfill:auto-cohosts:dry": "tsx scripts/backfill-auto-cohosts.ts",
    "backfill:auto-cohosts:local": "tsx scripts/backfill-auto-cohosts.ts --apply --no-sync-google",
    "backfill:auto-cohosts": "tsx scripts/backfill-auto-cohosts.ts --apply --sync-google",
    "sync:existing-cohosts": "tsx scripts/backfill-auto-cohosts.ts --apply --sync-google --sync-all-google",
    "seed:meet-hosts": "tsx scripts/seed-meet-hosts.ts",
    "assign:meet-hosts:dry": "tsx scripts/assign-future-meet-hosts.ts",
    "assign:meet-hosts": "tsx scripts/assign-future-meet-hosts.ts --apply",
    "recalcular:estados-reuniones:dry": "tsx scripts/recalcular-estados-solicitudes.ts",
    "recalcular:estados-reuniones": "tsx scripts/recalcular-estados-solicitudes.ts --apply",
    "forzar:modalidad-serie:dry": "tsx scripts/forzar-modalidad-serie.ts",
    "forzar:modalidad-serie": "tsx scripts/forzar-modalidad-serie.ts --apply",
    "agrupar:salud-mental:dry": "tsx scripts/agrupar-salud-mental-por-horario.ts",
    "agrupar:salud-mental": "tsx scripts/agrupar-salud-mental-por-horario.ts --apply",
    "test": "vitest run",
    "validate:schema": "node scripts/validate-schema.mjs",
    "ci:local": "bash scripts/deploy-ec2.sh --ci-only",
    "deploy": "bash scripts/deploy-ec2.sh",
    "deploy:quick": "bash scripts/deploy-ec2.sh --skip-ci",
    "deploy:status": "bash scripts/deploy-ec2.sh --status",
    "deploy:rollback": "bash scripts/deploy-ec2.sh --rollback",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "architecture": "depcruise src app auth.ts scripts test --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "driver.js": "1.10.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.3",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer-secure": "npm:nodemailer@^10.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-sonarjs": "^3.0.5",
    "knip": "^5.68.0",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "nanoid": "3.3.19",
    "uuid": "11.1.1"
  }
}
