{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.{ts,mjs}",
    // Las pruebas arquitectónicas leen estas fachadas y sus componentes desde el sistema de archivos.
    "src/modules/asistencia/presentation.ts",
    "src/modules/reuniones/presentation.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}", "test/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["scripts/legacy-meetings/**"]
}
