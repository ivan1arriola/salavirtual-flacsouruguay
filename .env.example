# Entorno local. En producción, cargar estos valores en el proveedor de hosting.

# Aplicación
APP_BASE_URL="https://salavirtual.flacso.edu.uy"
TIMEZONE="America/Montevideo"

# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/gestor_flacso_google_meet?schema=public"
LEGACY_DATABASE_URL="postgresql://usuario:password@localhost:5432/flacso_zoom?schema=public"

# Autenticación
AUTH_SECRET="cambiar-en-produccion"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
MIGRATION_DEFAULT_PASSWORD="cambiar-y-retirar-despues-de-la-migracion"
CRON_SECRET="generar-un-secreto-aleatorio"

# Cifrado de configuración (64 caracteres hexadecimales)
CONFIG_ENCRYPTION_KEY="generar-una-clave-hexadecimal-de-64-caracteres"

# Google Workspace: cuenta de servicio y delegación de dominio
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_SUBJECT=""

# Correo y recuperación de acceso
SMTP_FROM="noreply@flacso.edu.uy"
PASSWORD_WEBHOOK_URL=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# Notificaciones push (opcionales)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@flacso.edu.uy"

# Integración histórica de Zoom (opcional)
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_ACCOUNT_ID=""
ZOOM_GROUP_ID=""
ZOOM_API_BASE="https://api.zoom.us/v2"
ZOOM_WEBHOOK_SECRET_TOKEN=""
ZOOM_DRIVE_SYNC_API_BASE_URL=""
ZOOM_DRIVE_SYNC_API_KEY=""
ZOOM_DRIVE_AUTO_DOWNLOAD_FROM_WEBHOOK="false"

# Contabilidad histórica (opcional)
MONTHLY_ACCOUNTING_DRIVE_FOLDER_ID=""

# Importación histórica de Zoom (opcional)
ZOOM_HISTORICAL_IMPORT_ENABLED="false"
