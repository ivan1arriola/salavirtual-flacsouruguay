  claveParticipante    String
  participanteMeetId   String?
  nombre               String
  email                String?
  tipoAcceso           String        @default("CUENTA_GOOGLE")
  rolEnReunion         String        @default("PARTICIPANTE")
  conectado            Boolean       @default(false)
  primeraEntradaAt     DateTime?
  ultimaSalidaAt       DateTime?
  minutosConectado     Int           @default(0)
  porcentajeAsistencia Decimal?      @db.Decimal(5, 2)
  cumpleNormativa      Boolean       @default(false)
  numeroConexiones     Int           @default(1)
  esHostOCohost        Boolean       @default(false)
  enGrupoPequeno       Boolean       @default(false)
  salaGrupoPequeno     String?
  externo              Boolean?
  conferenciaId        String?
  origenCorreo         String?
  notasOperador        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  instancia            InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, claveParticipante])
  @@index([instanciaSalaId, conectado])
  @@index([instanciaSalaId, email])
}

