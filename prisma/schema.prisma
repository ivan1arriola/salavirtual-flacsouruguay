generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persona {
  id                 String              @id @default(cuid())
  nombres            String
  apellidos          String?
  documento          String?
  telefono           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  usuarios           Usuario[]
  docentes           Docente[]
  asistentes         Asistente[]

  @@index([apellidos, nombres])
}

model Usuario {
  id                 String              @id @default(cuid())
  personaId          String
  email              String              @unique
  passwordHash       String?
  rol                RolUsuario          @default(DOCENTE)
  activo             Boolean             @default(true)
  ultimoAccesoAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  persona            Persona             @relation(fields: [personaId], references: [id], onDelete: Restrict)
  solicitudesCreadas SolicitudSala[]     @relation("SolicitudCreadaPor")
  auditorias         Auditoria[]         @relation("AuditoriaActor")
  cuentas            AuthAccount[]
  sesiones           AuthSession[]

  @@index([personaId])
  @@index([rol, activo])
}

model UnidadAcademica {
  id          String      @id @default(cuid())
  nombre      String      @unique
  activa      Boolean     @default(true)
  programas   Programa[]
}

model Programa {
  id                 String              @id @default(cuid())
  unidadAcademicaId  String?
  nombre             String
  codigo             String?
  activo             Boolean             @default(true)
  unidadAcademica    UnidadAcademica?    @relation(fields: [unidadAcademicaId], references: [id], onDelete: SetNull)
  solicitudes         SolicitudSala[]

  @@unique([unidadAcademicaId, nombre])
  @@index([activo])
}

model Docente {
  id             String          @id @default(cuid())
  personaId      String          @unique
  observaciones  String?
  persona        Persona         @relation(fields: [personaId], references: [id], onDelete: Restrict)
  solicitudes    SolicitudSala[]
}

model Asistente {
  id                 String                   @id @default(cuid())
  personaId          String                   @unique
  aliasOperativo     String?
  disponibleGeneral  Boolean                  @default(true)
  datosPago          String?
  persona            Persona                  @relation(fields: [personaId], references: [id], onDelete: Restrict)
  disponibilidades   DisponibilidadAsistente[]
  intereses          InteresAsistenteEvento[]
  asignaciones       AsignacionAsistente[]
  liquidaciones      Liquidacion[]
}

model ProveedorReunion {
  id             String             @id @default(cuid())
  tipo           TipoProveedor       @unique
  nombre         String
  operativo      Boolean            @default(false)
  historico      Boolean            @default(false)
  cuentas        CuentaProveedor[]
  eventos        EventoProveedor[]
}

model CuentaProveedor {
  id                  String            @id @default(cuid())
  proveedorId         String
  nombre              String
  emailOrganizador    String?
  externalAccountId   String?
  secretRef           String?
  prioridad           Int               @default(100)
  activa              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  proveedor           ProveedorReunion  @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  eventosProveedor    EventoProveedor[]

  @@unique([proveedorId, externalAccountId])
  @@index([proveedorId, activa, prioridad])
}

model SolicitudSala {
  id                    String                @id @default(cuid())
  docenteId             String
  programaId            String?
  creadaPorUsuarioId    String
  titulo                String
  descripcion           String?
  modalidad             ModalidadReunion
  tipoInstancias        TipoInstancias
  timezone              String
  fechaInicioSolicitada DateTime
  fechaFinSolicitada    DateTime
  cantidadInstancias    Int                   @default(1)
  requiereAsistencia    Boolean               @default(false)
  requiereGrabacion     Boolean               @default(false)
  estado                EstadoSolicitud       @default(REGISTRADA)
  observacionesAdmin    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  docente               Docente               @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  programa              Programa?             @relation(fields: [programaId], references: [id], onDelete: SetNull)
  creadaPor             Usuario               @relation("SolicitudCreadaPor", fields: [creadaPorUsuarioId], references: [id], onDelete: Restrict)
  instancias            InstanciaSala[]

  @@index([estado, fechaInicioSolicitada])
  @@index([docenteId, estado])
  @@index([programaId])
}

model InstanciaSala {
  id                    String                 @id @default(cuid())
  solicitudSalaId        String
  ordinal               Int
  inicioProgramadoAt     DateTime
  finProgramadoAt        DateTime
  estado                EstadoInstancia        @default(PROGRAMADA)
  requiereAsistencia     Boolean               @default(false)
  requiereGrabacion      Boolean               @default(false)
  inicioRealAt           DateTime?
  finRealAt              DateTime?
  minutosReportados      Int?
  solicitud              SolicitudSala          @relation(fields: [solicitudSalaId], references: [id], onDelete: Cascade)
  eventosProveedor       EventoProveedor[]
  intereses              InteresAsistenteEvento[]
  asignaciones           AsignacionAsistente[]
  incidencias            Incidencia[]
  grabaciones            Grabacion[]
  liquidacionDetalles    LiquidacionDetalle[]

  @@unique([solicitudSalaId, ordinal])
  @@index([estado, inicioProgramadoAt])
}

model EventoProveedor {
  id                    String             @id @default(cuid())
  instanciaSalaId        String
  proveedorId            String
  cuentaProveedorId      String?
  externalEventId        String?
  joinUrl                String?
  hostUrl                String?
  payloadUltimo          Json?
  sincronizadoAt         DateTime?
  estadoIntegracion      EstadoIntegracion @default(PENDIENTE)
  errorIntegracion       String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  instancia              InstanciaSala       @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  proveedor              ProveedorReunion   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  cuentaProveedor        CuentaProveedor?   @relation(fields: [cuentaProveedorId], references: [id], onDelete: SetNull)

  @@unique([proveedorId, externalEventId])
  @@index([instanciaSalaId, proveedorId])
}

model Grabacion {
  id                   String            @id @default(cuid())
  instanciaSalaId       String
  proveedorId           String?
  origen                OrigenGrabacion
  titulo                String
  driveFileId           String?
  driveFolderId         String?
  mimeType              String?
  tamanoBytes           BigInt?
  urlHistorica          String?
  capturadaAt           DateTime?
  createdAt             DateTime          @default(now())
  instancia             InstanciaSala      @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@index([instanciaSalaId])
  @@index([origen, capturadaAt])
}

model InteresAsistenteEvento {
  id                  String                 @id @default(cuid())
  instanciaSalaId      String
  asistenteId          String
  estado               EstadoInteres         @default(ME_INTERESA)
  comentario           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  instancia            InstanciaSala           @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  asistente            Asistente               @relation(fields: [asistenteId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, asistenteId])
}

model AsignacionAsistente {
  id                   String            @id @default(cuid())
  instanciaSalaId       String
  asistenteId           String
  estado                EstadoAsignacion  @default(ASIGNADO)
  tarifaHoraAplicada    Decimal           @db.Decimal(10, 2)
  moneda                String
  minutosConfirmados    Int?
  montoConfirmado       Decimal?          @db.Decimal(12, 2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  instancia             InstanciaSala      @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  asistente             Asistente          @relation(fields: [asistenteId], references: [id], onDelete: Restrict)
  liquidacionDetalles   LiquidacionDetalle[]

  @@unique([instanciaSalaId, asistenteId])
  @@index([asistenteId, estado])
}

model DisponibilidadAsistente {
  id             String              @id @default(cuid())
  asistenteId    String
  diaSemana      Int?
  fecha          DateTime?
  horaDesde      String
  horaHasta      String
  timezone       String
  tipo           TipoDisponibilidad
  asistente      Asistente           @relation(fields: [asistenteId], references: [id], onDelete: Cascade)

  @@index([asistenteId, diaSemana])
  @@index([fecha])
}

model TarifaAsistencia {
  id             String          @id @default(cuid())
  modalidad      ModalidadReunion
  valorHora      Decimal         @db.Decimal(10, 2)
  moneda         String
  vigenteDesde   DateTime
  vigenteHasta   DateTime?
  estado         EstadoTarifa    @default(ACTIVA)

  @@index([modalidad, estado, vigenteDesde])
}

model Liquidacion {
  id              String                 @id @default(cuid())
  asistenteId      String
  periodoDesde     DateTime
  periodoHasta     DateTime
  estado           EstadoLiquidacion      @default(BORRADOR)
  subtotal         Decimal                @db.Decimal(12, 2)
  ajustes          Decimal                @default(0) @db.Decimal(12, 2)
  total            Decimal                @db.Decimal(12, 2)
  moneda           String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  asistente        Asistente              @relation(fields: [asistenteId], references: [id], onDelete: Restrict)
  detalles         LiquidacionDetalle[]

  @@index([asistenteId, periodoDesde, periodoHasta])
}

model LiquidacionDetalle {
  id                    String       @id @default(cuid())
  liquidacionId          String
  instanciaSalaId        String
  asignacionAsistenteId  String
  minutosLiquidados      Int
  tarifaHoraAplicada     Decimal      @db.Decimal(10, 2)
  montoLinea             Decimal      @db.Decimal(12, 2)
  liquidacion            Liquidacion   @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  instancia              InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Restrict)
  asignacion             AsignacionAsistente @relation(fields: [asignacionAsistenteId], references: [id], onDelete: Restrict)

  @@unique([liquidacionId, asignacionAsistenteId])
}

model Incidencia {
  id              String            @id @default(cuid())
  instanciaSalaId  String
  tipo            String
  severidad       SeveridadIncidencia
  descripcion     String
  estado          EstadoIncidencia  @default(ABIERTA)
  resolucion      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  instancia       InstanciaSala      @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@index([instanciaSalaId, estado])
}

model Auditoria {
  id             String    @id @default(cuid())
  actorUsuarioId String?
  accion         String
  entidadTipo    String
  entidadId      String
  valorAnterior  Json?
  valorNuevo     Json?
  correlacionId  String?
  createdAt      DateTime  @default(now())
  actor          Usuario?  @relation("AuditoriaActor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)

  @@index([entidadTipo, entidadId, createdAt])
}

model AuthAccount {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model AuthSession {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthVerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum RolUsuario {
  ADMINISTRADOR
  CONTADURIA
  ASISTENTE
  DOCENTE
}

enum TipoProveedor {
  GOOGLE_MEET
  ZOOM_HISTORICO
}

enum ModalidadReunion {
  HIBRIDA
  VIRTUAL
}

enum TipoInstancias {
  UNICA
  MULTIPLE
}

enum EstadoSolicitud {
  REGISTRADA
  PROVISIONANDO
  PROVISIONADA
  REQUIERE_REVISION
  CANCELADA
}

enum EstadoInstancia {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
  NO_REALIZADA
}

enum EstadoIntegracion {
  PENDIENTE
  SINCRONIZADA
  ERROR
  HISTORICA
}

enum OrigenGrabacion {
  GOOGLE_DRIVE
  ZOOM_HISTORICO
  MANUAL
}

enum EstadoInteres {
  ME_INTERESA
  NO_ME_INTERESA
  RETIRADO
}

enum EstadoAsignacion {
  ASIGNADO
  ACEPTADO
  RECHAZADO
  CANCELADO
}

enum TipoDisponibilidad {
  DISPONIBLE
  NO_DISPONIBLE
  PREFERENTE
}

enum EstadoTarifa {
  ACTIVA
  INACTIVA
}

enum EstadoLiquidacion {
  BORRADOR
  CERRADA
  APROBADA_CONTADURIA
  PAGADA
  ANULADA
}

enum SeveridadIncidencia {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoIncidencia {
  ABIERTA
  EN_ANALISIS
  RESUELTA
  CERRADA
}
