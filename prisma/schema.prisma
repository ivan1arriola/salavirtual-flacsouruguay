generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                                      String                           @id
  legacyZoomUserId                        String?                          @unique
  nombres                                 String
  apellidos                               String?
  telefono                                String?
  emailPrincipal                          String?                          @unique
  emailVerificadoAt                       DateTime?
  imagenUrl                               String?
  passwordHash                            String?
  passwordInicialCifrada                  String?                          @db.Text
  debeCambiarPassword                     Boolean                          @default(false)
  rol                                     RolUsuario                       @default(DOCENTE)
  activo                                  Boolean                          @default(true)
  ultimoAccesoAt                          DateTime?
  ultimoAccesoIp                          String?
  ultimoAccesoAgente                      String?
  ultimoProveedor                         String?
  fusionadoEnId                           String?
  fusionadoAt                             DateTime?
  createdAt                               DateTime                         @default(now())
  updatedAt                               DateTime                         @updatedAt
  fusionadoEn                             Usuario?                         @relation("UsuarioFusionDestino", fields: [fusionadoEnId], references: [id], onDelete: Restrict)
  usuariosFusionados                      Usuario[]                        @relation("UsuarioFusionDestino")
  solicitudesCreadas                      SolicitudSala[]                  @relation("SolicitudCreadaPor")
  auditorias                              Auditoria[]                      @relation("AuditoriaActor")
  emailAliases                            UsuarioEmailAlias[]
  cuentasGoogle                           CuentaGoogleFlacso[]
  sesiones                                SesionUsuario[]
  authenticators                          Authenticator[]
  fusionesComoOrigen                      UsuarioFusion[]                  @relation("FusionUsuarioOrigen")
  fusionesComoDestino                     UsuarioFusion[]                  @relation("FusionUsuarioDestino")
  fusionesEjecutadas                      UsuarioFusion[]                  @relation("FusionEjecutadaPor")
  configuracionesGoogleActualizadas       ConfiguracionGoogleWorkspace[]   @relation("ConfiguracionGoogleActualizadaPor")
  configuracionesAsistenciaActualizadas   ConfiguracionAsistenciaTecnica[] @relation("ConfiguracionAsistenciaActualizadaPor")
  configuracionesCorreoSesActualizadas    ConfiguracionCorreoSes[]        @relation("ConfiguracionCorreoSesActualizadaPor")
  configuracionesZoomActualizadas         ConfiguracionZoom[]              @relation("ConfiguracionZoomActualizadaPor")
  docente                                 Docente?
  asistenteTecnico                        AsistenteTecnico?
  notificaciones                          Notificacion[]
  recordatoriosReunion                    RecordatorioReunion[]
  preferenciasNotificacion                PreferenciaNotificacion[]
  solicitudesAccesoGoogleAprobadas        SolicitudAccesoGoogle[]         @relation("SolicitudesAccesoGoogleAprobadas")

  @@index([apellidos, nombres])
  @@index([rol, activo])
  @@index([fusionadoEnId])
}

model UsuarioEmailAlias {
  id        String   @id @default(cuid())
  usuarioId String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model UsuarioFusion {
  id               String   @id @default(cuid())
  usuarioOrigenId  String
  usuarioDestinoId String
  ejecutadaPorId   String
  motivo           String?
  snapshotOrigen   Json
  createdAt        DateTime @default(now())
  usuarioOrigen    Usuario  @relation("FusionUsuarioOrigen", fields: [usuarioOrigenId], references: [id], onDelete: Restrict)
  usuarioDestino   Usuario  @relation("FusionUsuarioDestino", fields: [usuarioDestinoId], references: [id], onDelete: Restrict)
  ejecutadaPor     Usuario  @relation("FusionEjecutadaPor", fields: [ejecutadaPorId], references: [id], onDelete: Restrict)

  @@index([usuarioOrigenId])
  @@index([usuarioDestinoId])
  @@index([ejecutadaPorId, createdAt])
}

model ConfiguracionGoogleWorkspace {
  id                    String   @id @default("principal")
  serviceAccountEmail   String?
  privateKeyCifrada     String?  @db.Text
  serviceAccountSubject String?
  driveDestinationId    String?
  activa                Boolean  @default(true)
  version               Int      @default(1)
  actualizadaPorId      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  actualizadaPor        Usuario  @relation("ConfiguracionGoogleActualizadaPor", fields: [actualizadaPorId], references: [id], onDelete: Restrict)

  @@index([actualizadaPorId, updatedAt])
}

model ConfiguracionZoom {
  id                  String   @id @default("principal")
  accountId           String?
  clientId            String?
  clientSecretCifrado String?  @db.Text
  activa              Boolean  @default(true)
  actualizadaPorId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  actualizadaPor      Usuario? @relation("ConfiguracionZoomActualizadaPor", fields: [actualizadaPorId], references: [id], onDelete: SetNull)

  @@index([actualizadaPorId, updatedAt])
}

model ConfiguracionAsistenciaTecnica {
  id                          String   @id @default("principal")
  correosCopiaReporteMensual  String[] @default([])
  actualizadaPorId            String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  actualizadaPor              Usuario  @relation("ConfiguracionAsistenciaActualizadaPor", fields: [actualizadaPorId], references: [id], onDelete: Restrict)

  @@index([actualizadaPorId, updatedAt])
}

model ConfiguracionCorreoSes {
  id             String   @id @default("principal")
  awsRegion      String?
  fromEmail      String?
  replyToEmail   String?
  activa         Boolean  @default(false)
  actualizadaPorId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  actualizadaPor Usuario  @relation("ConfiguracionCorreoSesActualizadaPor", fields: [actualizadaPorId], references: [id], onDelete: Restrict)

  @@index([actualizadaPorId, updatedAt])
}

model UnidadAcademica {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activa    Boolean    @default(true)
  programas Programa[]
}

model Programa {
  id                   String            @id @default(cuid())
  legacyZoomProgramaId String?           @unique
  unidadAcademicaId    String?
  nombre               String            @unique
  codigo               String?
  activo               Boolean           @default(true)
  unidadAcademica      UnidadAcademica?  @relation(fields: [unidadAcademicaId], references: [id], onDelete: SetNull)
  docentes             DocentePrograma[]

  @@index([activo])
}

model Docente {
  id                 String            @id @default(cuid())
  usuarioId          String            @unique
  documentoIdentidad String?
  observaciones      String?
  usuario            Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  programas          DocentePrograma[]
}

model DocentePrograma {
  id          String          @id @default(cuid())
  docenteId   String
  programaId  String
  activo      Boolean         @default(true)
  desde       DateTime?
  hasta       DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  docente     Docente         @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  programa    Programa        @relation(fields: [programaId], references: [id], onDelete: Restrict)
  solicitudes SolicitudSala[]

  @@unique([docenteId, programaId])
  @@index([programaId, activo])
}

/// Persona habilitada para realizar asistencias tecnicas en reuniones.
model AsistenteTecnico {
  id                             String                            @id @default(cuid())
  usuarioId                      String                            @unique
  slug                           String                            @unique
  aliasOperativo                 String?
  disponibleGeneral              Boolean                           @default(true)
  cesadoHastaProximoInicioSesion Boolean                           @default(false)
  datosPago                      String?
  usuario                        Usuario                           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  disponibilidades               DisponibilidadAsistenteTecnico[]
  intereses                      PostulacionAsistenciaTecnica[]
  asignaciones                   AsignacionAsistenciaTecnica[]
  liquidaciones                  LiquidacionAsistenciaTecnica[]
  reportesMensuales              EnvioReporteMensualAsistencia[]
  registrosMonitoreoRetroactivo   RegistroMonitoreoRetroactivo[]
}

model EnvioReporteMensualAsistencia {
  id                 String                           @id @default(cuid())
  asistenteTecnicoId String
  periodo            String
  estado             EstadoEnvioReporteMensual       @default(PENDIENTE)
  minutosTotal       Int
  minutosVirtuales   Int
  minutosHibridos    Int
  reuniones          Int
  destinatario       String
  copias             String[]                         @default([])
  intentos           Int                              @default(1)
  ultimoError        String?
  enviadoAt          DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  asistenteTecnico   AsistenteTecnico                 @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Restrict)

  @@unique([asistenteTecnicoId, periodo])
  @@index([periodo, estado])
}

model ProveedorReunion {
  id        String            @id @default(cuid())
  tipo      TipoProveedor     @unique
  nombre    String
  operativo Boolean           @default(false)
  historico Boolean           @default(false)
  cuentas   CuentaProveedor[]
  eventos   EventoProveedor[]
}

model CuentaProveedor {
  id                 String            @id @default(cuid())
  legacyZoomCuentaId String?           @unique
  proveedorId        String
  nombre             String
  emailOrganizador   String?
  externalAccountId  String?
  secretRef          String?
  prioridad          Int               @default(100)
  tieneLicencia      Boolean           @default(false)
  limiteConcurrente  Int?
  activa             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  proveedor          ProveedorReunion  @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  eventosProveedor   EventoProveedor[]

  @@unique([proveedorId, externalAccountId])
  @@index([proveedorId, activa, prioridad])
}

model SolicitudSala {
  id                        String           @id @default(cuid())
  legacyZoomSolicitudId     String?          @unique
  claveIdempotenciaCreacion String?          @unique
  serieReunionId            String?
  docenteProgramaId         String
  creadaPorUsuarioId        String
  titulo                    String
  descripcion               String?
  responsableNombre         String?
  finalidadAcademica        String?
  modalidad                 ModalidadReunion
  tipoInstancias            TipoInstancias
  timezone                  String
  fechaInicioSolicitada     DateTime
  fechaFinSolicitada        DateTime
  cantidadInstancias        Int              @default(1)
  capacidadEstimada         Int?
  requiereAsistenciaTecnica Boolean          @default(false)
  inicioAsistenciaTecnicaAt  DateTime?
  finAsistenciaTecnicaAt     DateTime?
  motivoAsistenciaTecnica   String?
  requiereGrabacion         Boolean          @default(false)
  regimenEncuentros         String?
  fechaFinRecurrencia       DateTime?
  patronRecurrencia         Json?
  estado                    EstadoSolicitud  @default(REGISTRADA)
  observacionesAdmin        String?
  canceladaAt               DateTime?
  canceladaMotivo           String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  docentePrograma           DocentePrograma  @relation(fields: [docenteProgramaId], references: [id], onDelete: Restrict)
  creadaPor                 Usuario          @relation("SolicitudCreadaPor", fields: [creadaPorUsuarioId], references: [id], onDelete: Restrict)
  instancias                InstanciaSala[]

  @@index([estado, fechaInicioSolicitada])
  @@index([docenteProgramaId, estado])
  @@index([serieReunionId])
}

model InstanciaSala {
  id                        String                                @id @default(cuid())
  legacyZoomEventoId        String?                               @unique
  solicitudSalaId           String
  ordinal                   Int
  descripcion               String?
  inicioProgramadoAt          DateTime
  finProgramadoAt             DateTime
  modalidadOverride           ModalidadReunion?
  inicioAsistenciaTecnicaAt   DateTime?
  finAsistenciaTecnicaAt      DateTime?
  timezone                    String
  estado                      EstadoInstancia                       @default(PROGRAMADA)
  proveedorActivoTipo         TipoProveedor?
  conservarGoogleMeet         Boolean                               @default(false)
  motivoConservarGoogleMeet   String?
  requiereAsistenciaTecnica   Boolean                               @default(false)
  requiereGrabacion         Boolean                               @default(false)
  inicioRealAt              DateTime?
  finRealAt                 DateTime?
  minutosReportados         Int?
  comentariosReporte        String?
  costoEstimado             Decimal?                              @db.Decimal(12, 2)
  costoReal                 Decimal?                              @db.Decimal(12, 2)
  solicitud                 SolicitudSala                         @relation(fields: [solicitudSalaId], references: [id], onDelete: Cascade)
  eventosProveedor          EventoProveedor[]
  postulaciones             PostulacionAsistenciaTecnica[]
  asignaciones              AsignacionAsistenciaTecnica[]
  incidencias               Incidencia[]
  grabaciones               Grabacion[]
  detallesLiquidacion       DetalleLiquidacionAsistenciaTecnica[]
  cohosts                   CohostReunion[]
  cohostEmails              CohostEmailReunion[]
  invitados                 InvitadoReunion[]
  recordatoriosInvitados     RecordatorioInvitadoReunion[]
  avisosMigracionZoom       AvisoMigracionZoom[]
  registrosAsistencia       RegistroAsistenciaMeet[]
  registrosMonitoreoRetroactivo RegistroMonitoreoRetroactivo[]
  recordatorios             RecordatorioReunion[]

  @@unique([solicitudSalaId, ordinal])
  @@index([estado, inicioProgramadoAt])
  @@index([proveedorActivoTipo, conservarGoogleMeet, estado, inicioProgramadoAt], map: "InstanciaSala_migracion_zoom_idx")
}

model EventoProveedor {
  id                      String            @id @default(cuid())
  instanciaSalaId         String
  proveedorId             String
  cuentaProveedorId       String?
  externalEventId         String?
  codigoReunion           String?
  joinUrl                 String?
  hostUrl                 String?
  payloadUltimo           Json?
  sincronizadoAt          DateTime?
  estadoIntegracion       EstadoIntegracion @default(PENDIENTE)
  operacionPendiente      OperacionIntegracionProveedor?
  reclamoIntegracionAt    DateTime?
  reclamoIntegracionToken String?
  errorIntegracion        String?
  conferenceRecordName    String?
  grabacionEstadoMeet     String?
  grabacionObservadaAt    DateTime?
  driveFolderId           String?
  archivosSincronizadosAt DateTime?
  errorArchivos           String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  instancia               InstanciaSala     @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  proveedor               ProveedorReunion  @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  cuentaProveedor         CuentaProveedor?  @relation(fields: [cuentaProveedorId], references: [id], onDelete: SetNull)
  archivos                ArchivoReunion[]

  @@unique([proveedorId, externalEventId])
  @@unique([instanciaSalaId, proveedorId])
  @@index([instanciaSalaId, proveedorId])
  @@index([grabacionEstadoMeet, grabacionObservadaAt])
}

model ArchivoReunion {
  id                   String             @id @default(cuid())
  eventoProveedorId    String
  tipo                 TipoArchivoReunion
  externalResourceName String
  driveFileId          String             @unique
  nombre               String
  mimeType             String?
  tamanoBytes          BigInt?
  webViewUrl           String?
  capturadoAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  eventoProveedor      EventoProveedor    @relation(fields: [eventoProveedorId], references: [id], onDelete: Cascade)

  @@unique([eventoProveedorId, externalResourceName])
  @@index([eventoProveedorId, tipo])
  @@index([tipo, capturadoAt])
}

model CohostReunion {
  id              String             @id @default(cuid())
  instanciaSalaId String
  cuentaGoogleId  String
  createdAt       DateTime           @default(now())
  instancia       InstanciaSala      @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  cuentaGoogle    CuentaGoogleFlacso @relation(fields: [cuentaGoogleId], references: [id], onDelete: Restrict)

  @@unique([instanciaSalaId, cuentaGoogleId])
  @@index([cuentaGoogleId])
}

model CohostEmailReunion {
  id              String        @id @default(cuid())
  instanciaSalaId String
  email           String
  createdAt       DateTime      @default(now())
  instancia       InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, email])
  @@index([email])
}

/// Participante invitado, independiente de los permisos de anfitrión/coanfitrión.

model RecordatorioInvitadoReunion {
  id                String       @id @default(cuid())
  instanciaSalaId    String
  email             String
  inicioProgramadoAt DateTime
  estado            String       @default("RESERVADO")
  enviadoAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  instancia         InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, email, inicioProgramadoAt], map: "RecordatorioInvitadoUnico")
  @@index([estado, createdAt])
}

/// Outbox del aviso de migración Meet → Zoom: una fila por encuentro y correo.
/// RESERVADO = envío en curso o incierto (no se reintenta solo), ACEPTADO = enviado,
/// ERROR = fallo confirmado y reintentable, OBSOLETO = el encuentro dejó de ser válido.
model AvisoMigracionZoom {
  id                 String        @id @default(cuid())
  instanciaSalaId    String
  email              String
  inicioProgramadoAt DateTime
  joinUrl            String
  estado             String        @default("RESERVADO")
  intentos           Int           @default(1)
  errorCodigo        String?
  enviadoAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  instancia          InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, email], map: "AvisoMigracionZoomUnico")
  @@index([estado, updatedAt])
}

model InvitadoReunion {
  id              String       @id @default(cuid())
  instanciaSalaId  String
  email           String
  nombre          String?
  createdAt       DateTime     @default(now())
  instancia       InstanciaSala @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, email])
  @@index([email])
}

model Grabacion {
  id              String          @id @default(cuid())
  instanciaSalaId String
  proveedorId     String?
  origen          OrigenGrabacion
  titulo          String
  driveFileId     String?
  driveFolderId   String?
  mimeType        String?
  tamanoBytes     BigInt?
  urlHistorica    String?
  capturadaAt     DateTime?
  createdAt       DateTime        @default(now())
  instancia       InstanciaSala   @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)

  @@index([instanciaSalaId])
  @@index([origen, capturadaAt])
}

/// Postulacion de un asistente tecnico para realizar la asistencia de una instancia.
model PostulacionAsistenciaTecnica {
  id                 String                             @id @default(cuid())
  instanciaSalaId    String
  asistenteTecnicoId String
  estado             EstadoPostulacionAsistenciaTecnica @default(ME_INTERESA)
  comentario         String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  instancia          InstanciaSala                      @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  asistenteTecnico   AsistenteTecnico                   @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Cascade)

  @@unique([instanciaSalaId, asistenteTecnicoId], map: "PostulacionAT_instancia_asistente_key")
}

/// Adjudicacion de la asistencia tecnica de una instancia a un asistente tecnico.
model AsignacionAsistenciaTecnica {
  id                        String                                @id @default(cuid())
  legacyZoomAsignacionId    String?                               @unique
  instanciaSalaId           String
  asistenteTecnicoId        String
  tarifaAsistenciaTecnicaId String
  estado                    EstadoAsignacionAsistenciaTecnica     @default(ASIGNADO)
  tarifaHoraAplicada        Decimal                               @db.Decimal(10, 2)
  moneda                    String
  minutosConfirmados        Int?
  montoConfirmado           Decimal?                              @db.Decimal(12, 2)
  createdAt                 DateTime                              @default(now())
  updatedAt                 DateTime                              @updatedAt
  instancia                 InstanciaSala                         @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  asistenteTecnico          AsistenteTecnico                      @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Restrict)
  tarifaAsistenciaTecnica   TarifaAsistenciaTecnica               @relation(fields: [tarifaAsistenciaTecnicaId], references: [id], onDelete: Restrict)
  detallesLiquidacion       DetalleLiquidacionAsistenciaTecnica[]

  @@unique([instanciaSalaId, asistenteTecnicoId], map: "AsignacionAT_instancia_asistente_key")
  @@index([asistenteTecnicoId, estado])
  @@index([tarifaAsistenciaTecnicaId])
}

/// Registro histórico pendiente de control administrativo: NO participa en pagos
/// hasta que una aprobación explícita crea la asignación confirmada.
model RegistroMonitoreoRetroactivo {
  id                       String           @id @default(cuid())
  instanciaSalaId          String
  asistenteTecnicoId       String
  inicioRealAt             DateTime
  finRealAt                DateTime
  minutos                  Int
  tarifaAsistenciaTecnicaId String
  tarifaHora               Decimal          @db.Decimal(10, 2)
  moneda                   String
  montoEstimado            Decimal          @db.Decimal(12, 2)
  motivo                   String
  estado                   String           @default("PENDIENTE")
  creadoPorUsuarioId       String
  revisadoPorUsuarioId     String?
  motivoRechazo            String?
  revisadoAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  instancia                InstanciaSala    @relation(fields: [instanciaSalaId], references: [id], onDelete: Cascade)
  asistente                AsistenteTecnico @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Restrict)

  @@index([instanciaSalaId, estado])
  @@index([asistenteTecnicoId, estado])
}

/// Franja en la que un asistente tecnico esta disponible o no disponible.
model DisponibilidadAsistenteTecnico {
  id                 String                             @id @default(cuid())
  asistenteTecnicoId String
  diaSemana          Int?
  fecha              DateTime?
  horaDesde          String
  horaHasta          String
  timezone           String
  tipo               TipoDisponibilidadAsistenteTecnico
  asistenteTecnico   AsistenteTecnico                   @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Cascade)

  @@index([asistenteTecnicoId, diaSemana])
  @@index([fecha])
}

/// Tarifa versionada usada para valorar una asistencia tecnica.
model TarifaAsistenciaTecnica {
  id           String                        @id @default(cuid())
  modalidad    ModalidadReunion
  valorHora    Decimal                       @db.Decimal(10, 2)
  moneda       String
  createdAt    DateTime                      @default(now())
  asignaciones AsignacionAsistenciaTecnica[]

  @@index([modalidad, createdAt])
}

/// Liquidacion economica de las asistencias tecnicas realizadas por una persona.
model LiquidacionAsistenciaTecnica {
  id                 String                                @id @default(cuid())
  asistenteTecnicoId String
  periodoDesde       DateTime
  periodoHasta       DateTime
  estado             EstadoLiquidacionAsistenciaTecnica    @default(BORRADOR)
  subtotal           Decimal                               @db.Decimal(12, 2)
  ajustes            Decimal                               @default(0) @db.Decimal(12, 2)
  total              Decimal                               @db.Decimal(12, 2)
  moneda             String
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  asistenteTecnico   AsistenteTecnico                      @relation(fields: [asistenteTecnicoId], references: [id], onDelete: Restrict)
  detalles           DetalleLiquidacionAsistenciaTecnica[]

  @@index([asistenteTecnicoId, periodoDesde, periodoHasta])
}

/// Linea que incorpora una asistencia tecnica adjudicada a una liquidacion.
model DetalleLiquidacionAsistenciaTecnica {
  id                             String                       @id @default(cuid())
  liquidacionAsistenciaTecnicaId String
  instanciaSalaId                String
  asignacionAsistenciaTecnicaId  String
  minutosLiquidados              Int
  tarifaHoraAplicada             Decimal                      @db.Decimal(10, 2)
  montoLinea                     Decimal                      @db.Decimal(12, 2)
  liquidacionAsistenciaTecnica   LiquidacionAsistenciaTecnica @relation(fields: [liquidacionAsistenciaTecnicaId], references: [id], onDelete: Cascade, map: "DetalleLiquidacionAT_liquidacion_fk")
  instancia                      InstanciaSala                @relation(fields: [instanciaSalaId], references: [id], onDelete: Restrict)
  asignacionAsistenciaTecnica    AsignacionAsistenciaTecnica  @relation(fields: [asignacionAsistenciaTecnicaId], references: [id], onDelete: Restrict, map: "DetalleLiquidacionAT_asignacion_fk")

  @@unique([liquidacionAsistenciaTecnicaId, asignacionAsistenciaTecnicaId], map: "DetalleLiquidacionAT_liquidacion_asignacion_key")
}

model Incidencia {
