[Unit]
Description=Sala Virtual FLACSO - conservar archivos de Zoom en Drive (worker)
After=network-online.target salavirtual.service
Wants=network-online.target

# No se habilita solo: un administrador lo hace tras la prueba real con un encuentro controlado
#   sudo systemctl enable --now salavirtual-zoom-archivos.service
# Desde entonces cada deploy lo detiene antes del build y lo reinicia con el release vigente.

[Service]
Type=simple
User=salavirtual
Group=salavirtual
WorkingDirectory=/srv/apps/salavirtual-flacso/current
Environment=NODE_ENV=production
# Ajustar memoria y CPU al tamaño real de la EC2 al activarlo; el bloque de subida es de 8 MiB y
# los archivos nunca se cargan completos en memoria.
Environment=ZOOM_ARCHIVOS_CONCURRENCIA=1
EnvironmentFile=/srv/apps/salavirtual-flacso/shared/.env.production
ExecStart=/usr/bin/node --max-old-space-size=384 zoom-archivos-worker.cjs
Restart=on-failure
RestartSec=60
# Mayor que la espera HTTP sin progreso (60 s): el apagado ordenado aborta E/S y suelta el lease.
TimeoutStopSec=90
KillSignal=SIGTERM
MemoryMax=768M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/apps/salavirtual-flacso

[Install]
WantedBy=multi-user.target
